<view class="page">
  <text class="eyebrow">我的记录</text>
  <view class="title">以前的节奏</view>
  <view class="subtitle">只看自己的记录。删除后无法恢复，请确认是你想删的那一条。</view>
  <view wx:if="{{loading}}" class="card muted">正在读取…</view>
  <view wx:elif="{{!records.length}}" class="card"><view class="card-title">还没有保存记录</view><view class="muted" style="margin-top:14rpx;">想记录时再开始，不需要每天打卡。</view></view>
  <view wx:for="{{records}}" wx:key="id" class="card">
    <view class="date">{{item.dateLabel}}</view>
    <view class="card-title" style="margin-top:12rpx;">{{item.summary || '这次记录没有 AI 小结'}}</view>
    <view wx:if="{{item.small_step}}" class="notice">可以先做：{{item.small_step}}</view>
    <button class="delete" data-id="{{item.id}}" bindtap="confirmDelete" disabled="{{deletingId}}">{{deletingId === item.id ? '正在删除…' : '删除这条记录'}}</button>
  </view>
  <view wx:if="{{message}}" class="notice {{isError ? 'error' : ''}}">{{message}}</view>
</view>
