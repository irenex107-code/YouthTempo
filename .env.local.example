E2E_PERMISSION_TEST_PASSWORD=your_long_test_only_password
WECHAT_MINI_APP_ID=your_wechat_mini_app_id
WECHAT_MINI_APP_SECRET=your_wechat_mini_app_secret
WECHAT_MINI_BIND_PAGE=pages/index/index
# 可选：将脱敏后的登录、保存、AI 与社区错误事件转发到告警接收端
ERROR_MONITOR_WEBHOOK_URL=
ERROR_MONITOR_WEBHOOK_TOKEN=
