{
  "name": "youthtempo-prototype",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Lint is not configured yet; use build and TypeScript checks.\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:permissions": "node --env-file=.env.local node_modules/@playwright/test/cli.js test tests/authenticated-permission-boundary.spec.ts tests/authenticated-api-overreach.spec.ts tests/membership-revocation.spec.ts",
    "test:e2e:sweet": "node --env-file=.env.local node_modules/@playwright/test/cli.js test tests/sweet-record-lifecycle.spec.ts",
    "env:check": "node --env-file=.env.local scripts/check-local-env.mjs",
    "test:fixtures:permissions": "node --env-file=.env.local scripts/setup-permission-test-fixtures.mjs",
    "test:fixtures:permissions:cleanup": "node --env-file=.env.local scripts/setup-permission-test-fixtures.mjs --cleanup"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@next/swc-darwin-arm64": "15.5.19",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
